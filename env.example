# Copy this file to .env and fill in your real keys.
# NEVER commit the actual .env file — add it to .gitignore.

GROQ_API_KEY=
GEMINI_API_KEY=

# Local Ollama needs no key — just make sure `ollama serve` is running
# and the model is pulled: `ollama pull llama3.2:1b`
OLLAMA_BASE_URL=http://localhost:11434/v1
